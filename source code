package com.retail.service;

import com.retail.model.Product;
import com.retail.exception.InsufficientStockException;
import java.util.ArrayList;
import java.util.List;
import java.util.Vector;
import java.util.Stack;

// Unit 3 & 5: Singleton Pattern, Collections Framework (List, Vector, Stack), Jagged Arrays
public class InventoryManager {
    private static InventoryManager instance;

    // Collections Framework components
    private final List<Product> productList = new ArrayList<>();
    private final Vector<String> transactionLogs = new Vector<>();
    private final Stack<String> recentActions = new Stack<>();

    // 2D Jagged Array representing irregular warehouse shelf capacity
    private final int[][] warehouseGrid = new int[2][];

    private InventoryManager() {
        // Aisle 0 has 2 shelves, Aisle 1 has 4 shelves
        warehouseGrid[0] = new int[]{10, 20};
        warehouseGrid[1] = new int[]{5, 15, 25, 35};
    }

    // Singleton Thread-Safe Instance Provider
    public static synchronized InventoryManager getInstance() {
        if (instance == null) {
            instance = new InventoryManager();
        }
        return instance;
    }

    public void addProduct(Product product) {
        productList.add(product);
        recentActions.push("Added product: " + product.getName());
    }

    // Synchronized method to prevent race conditions during multithreaded orders
    public synchronized void updateStock(int productId, int qty) throws InsufficientStockException {
        for (Product p : productList) {
            if (p.getId() == productId) {
                if (p.getStock() < qty) {
                    throw new InsufficientStockException("Insufficient stock for product ID: " + productId);
                }
                p.setStock(p.getStock() - qty);
                transactionLogs.add("Deducted " + qty + " units from product ID: " + productId);
                return;
            }
        }
        throw new InsufficientStockException("Product ID " + productId + " not found.");
    }

    public List<Product> getProductList() {
        return productList;
    }

    public void displayWarehouseLayout() {
        System.out.println("--- Warehouse Jagged Array Capacities ---");
        for (int i = 0; i < warehouseGrid.length; i++) {
            System.out.print("Aisle " + i + " Shelves: ");
            for (int j = 0; j < warehouseGrid[i].length; j++) {
                System.out.print("[" + warehouseGrid[i][j] + " items] ");
            }
            System.out.println();
        }
    }
}


package com.retail.service;

import java.io.BufferedWriter;
import java.io.BufferedReader;
import java.io.FileWriter;
import java.io.FileReader;
import java.io.File;
import java.io.IOException;

// Unit 5: Byte/Character I/O Streams, File Processing
public class AuditLogger {
    private static final String FILE_PATH = "audit_log.txt";

    // Write using Character-oriented Stream (FileWriter / BufferedWriter)
    public static synchronized void writeLog(String message) {
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(FILE_PATH, true))) {
            writer.write(System.currentTimeMillis() + " - " + message);
            writer.newLine();
        } catch (IOException e) {
            System.err.println("I/O Error writing to log: " + e.getMessage());
        }
    }

    // Read using Character-oriented Stream (FileReader / BufferedReader)
    public static void readLogs() {
        File logFile = new File(FILE_PATH);
        if (!logFile.exists()) {
            System.out.println("No log file found.");
            return;
        }

        try (BufferedReader reader = new BufferedReader(new FileReader(logFile))) {
            String line;
            while ((line = reader.readLine()) != null) {
                System.out.println(line);
            }
        } catch (IOException e) {
            System.err.println("I/O Error reading from log: " + e.getMessage());
        }
    }
}

package com.retail.service;

import com.retail.exception.InsufficientStockException;

// Unit 4: Multithreading (Extending Thread), Life Cycle & Synchronization
public class BatchProcessor extends Thread {
    private final InventoryManager manager;
    private final int productId;
    private final int quantity;

    public BatchProcessor(InventoryManager manager, int productId, int quantity) {
        this.manager = manager;
        this.productId = productId;
        this.quantity = quantity;
    }

    @Override
    public void run() {
        try {
            System.out.println(Thread.currentThread().getName() + " starting stock modification...");
            manager.updateStock(productId, quantity);
            AuditLogger.writeLog(Thread.currentThread().getName() + " successfully bought " + quantity + " units.");
            System.out.println(Thread.currentThread().getName() + " completed successfully.");
        } catch (InsufficientStockException e) {
            AuditLogger.writeLog(Thread.currentThread().getName() + " failed: " + e.getMessage());
            System.err.println(Thread.currentThread().getName() + " Exception: " + e.getMessage());
        }
    }
}

package com.retail.db;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

// Unit 5: Database Applications with JDBC API
public class DatabaseConfig {
    private static final String DB_URL = "jdbc:mysql://localhost:3306/retail_db";
    private static final String USER = "root";
    private static final String PASS = "password";

    public static Connection getConnection() throws SQLException {
        try {
            // Load Driver explicitly
            Class.forName("com.mysql.cj.jdbc.Driver");
        } catch (ClassNotFoundException e) {
            System.out.println("JDBC Driver missing from classpath.");
        }
        return DriverManager.getConnection(DB_URL, USER, PASS);
    }

    public static void executeSampleQuery() {
        String query = "SELECT * FROM inventory";
        try (Connection conn = getConnection();
             PreparedStatement stmt = conn.prepareStatement(query);
             ResultSet rs = stmt.executeQuery()) {

            while (rs.next()) {
                System.out.println("Product from DB: " + rs.getString("name"));
            }
        } catch (SQLException e) {
            System.out.println("[JDBC Fallback] Database connection failed or database server offline (Expected if MySQL service isn't running).");
        }
    }
}

package com.retail;

import com.retail.annotation.ModuleInfo;
import com.retail.exception.InsufficientStockException;
import com.retail.model.*;
import com.retail.service.*;
import com.retail.db.DatabaseConfig;

// Core Entry Point demonstrating Flow Control, Switch, Reflection & Collections
@ModuleInfo(author = "Java Developer", version = "2.0")
public class Main {
    public static void main(String[] args) {
        System.out.println("=== SMART RETAIL SYSTEM INITIALIZATION ===");

        // Unit 1: Java Flow Control (If-Else & Switch Statements)
        int mode = 1;
        switch (mode) {
            case 1:
                System.out.println("Status: Mode set to Live Execution.");
                break;
            default:
                System.out.println("Status: Maintenance Mode.");
                return;
        }

        // Unit 2 & Dynamic Polymorphism
        Product laptop = new Electronics(101, "Gaming Laptop", 1200.00, 5, 24);
        System.out.println("\nCreated Product: " + laptop);
        System.out.println("Calculated Tax (Dynamic Dispatch): $" + laptop.calculateTax());

        // Unit 3: Anonymous Class implementation of Processable Interface
        Processable quickOrderProcessor = new Processable() {
            @Override
            public void processOrder(int productId, int quantity) throws InsufficientStockException {
                System.out.println("\n[Anonymous Class] Processing quick order for item ID " + productId);
                InventoryManager.getInstance().updateStock(productId, quantity);
            }
        };

        // Unit 3: Enum Usage
        OrderStatus status = OrderStatus.PROCESSING;
        System.out.println("Order State: " + status + " (" + status.getDescription() + ")");

        // Singleton & Collections Setup
        InventoryManager manager = InventoryManager.getInstance();
        manager.addProduct(laptop);
        manager.displayWarehouseLayout();

        // Process anonymous class order
        try {
            quickOrderProcessor.processOrder(101, 1);
        } catch (InsufficientStockException e) {
            System.err.println(e.getMessage());
        }

        // Unit 4: Multithreading & Synchronization (Concurrent Order Execution)
        System.out.println("\n--- Initiating Multithreaded Processing ---");
        BatchProcessor worker1 = new BatchProcessor(manager, 101, 2);
        BatchProcessor worker2 = new BatchProcessor(manager, 101, 3); // Intentional stock failure

        worker1.setName("Thread-Worker-1");
        worker2.setName("Thread-Worker-2");

        worker1.start();
        worker2.start();

        try {
            worker1.join();
            worker2.join();
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }

        // Unit 5: Reading Log File generated via File I/O Streams
        System.out.println("\n--- Audit Logs File Output (Character Streams) ---");
        AuditLogger.readLogs();

        // Unit 5: Executing Database Queries (JDBC)
        System.out.println("\n--- Testing Database API Connection ---");
        DatabaseConfig.executeSampleQuery();

        // Unit 3: Reflection API Demonstration
        System.out.println("\n--- Java Reflection Inspection ---");
        try {
            Class<?> clazz = Class.forName("com.retail.model.Electronics");
            System.out.println("Inspected Class Name: " + clazz.getName());
            System.out.println("Superclass: " + clazz.getSuperclass().getName());
        } catch (ClassNotFoundException e) {
            e.printStackTrace();
        }

        System.out.println("\n=== EXECUTION COMPLETED SUCCESSFULLY ===");
    }
}

